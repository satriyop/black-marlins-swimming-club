# Postgres on aidev (localhost). Leave unset for local PGLite.
DATABASE_URL=postgres://bmsc:bmsc@127.0.0.1:5432/bmsc

# Better Auth — required in production
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://your-tunnel-domain.example
VITE_AUTH_ENABLED=true

# Google OAuth (adults). Redirect: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres on aidev (localhost). Leave unset for local PGLite.
# Native deploy (scripts/bmsc.sh) writes this; compose is not used on aidev.
DATABASE_URL=postgres://bmsc:bmsc@127.0.0.1:5432/bmsc

# Better Auth — required in production
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://bmsc.klaten.org
VITE_AUTH_ENABLED=true
SPECTRA_API_KEY=

# Google OAuth (adults). Redirect: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: directory holding the real, gitignored data/*.local.json overrides
# (seed.local.json, default-training-schedules.local.json) used by npm run db:seed
# and db:import-kiko. Needed in production because each release runs from a fresh
# releases/<sha> directory -- see docs/aidev-deploy.md. Leave unset for local dev.
# BMSC_DATA_LOCAL_DIR=/var/www/bmsc/data
